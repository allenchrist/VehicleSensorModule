# Code style, checked by ktlint: ./gradlew ktlintCheck, fixed by ./gradlew ktlintFormat
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 120

# Compose screens are named like classes, such as MainScreen
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,json,yml,toml}]
indent_size = 2
