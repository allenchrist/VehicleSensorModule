<?xml version="1.0" encoding="utf-8"?>
<!-- For Android 12 and above. The login and device ID belong to this phone only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
